@page
@model InvPj.Pages.IndexModel

<p>Общий баланс: @Model.TotalBalance</p>

<h1>Добавить инвестицию (Razor Pages)</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="NewInvestment.InvestorName">Имя инвестора</label>
        <input asp-for="NewInvestment.InvestorName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="NewInvestment.Amount">Сумма</label>
        <input asp-for="NewInvestment.Amount" class="form-control" type="number" step="0.01" />
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>

@* Здесь вы можете добавить отображение уже существующих инвестиций, если нужно *@
